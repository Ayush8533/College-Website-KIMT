      "destination": "https://kimt-portal.onrender.com/admin"
    },
    {
      "source": "/admin-panel",
      "destination": "https://kimt-portal.onrender.com/admin"
    },
    {
      "source": "/admin-panel/:path*",
      "destination": "https://kimt-portal.onrender.com/admin/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://kimt-portal.onrender.com/api/:path*"
    }
  ]
